{
  "name": "soodering",
  "version": "1.0.0",
  "private": true,
  "description": "SooDering cafeteria lunch ordering helper.",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "check": "node --check server.js && node --check electron-main.js && node --check preload.js && node --check public/app.js",
    "test": "node --test",
    "ci": "npm run check && npm test",
    "build:mac": "electron-builder --mac dir --arm64",
    "build:win": "electron-builder --win dir --x64",
    "build:portable": "electron-builder --win portable --x64"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.soodering.app",
    "productName": "SooDering",
    "directories": {
      "output": "dist-portable"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "server.js",
      "config.js",
      "package.json",
      "public/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "SooDering-Portable.exe"
    },
    "asar": true
  }
}
